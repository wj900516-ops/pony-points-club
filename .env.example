# ===== Database (Supabase Postgres or local PostgreSQL) =====
# Runtime (Vercel/app): Supabase transaction pooler, port 6543, usually with ?pgbouncer=true
DATABASE_URL=

# Prisma migrate/deploy: Supabase session/direct connection, port 5432, without pgbouncer=true
DIRECT_URL=

# ===== Auth (custom email/password, not Supabase Auth) =====
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Local .env may use development. Do not set NODE_ENV on Vercel; the platform sets production.
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# Local http: false. Vercel/production HTTPS: true.
AUTH_COOKIE_SECURE=false

# ===== Email (P3-A forgot/reset password) =====
# Production Vercel must set RESEND_API_KEY.
# Local development without RESEND_API_KEY prints the reset link in the server log.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=小马积分俱乐部 <noreply@xiaolinmlp.com>

# ===== Reward image storage =====
# local = write into public/uploads/rewards (local dev only)
# supabase = Supabase Storage (required for Vercel production uploads)
STORAGE_DRIVER=local

# Supabase Storage upload only; this project does not use Supabase Auth.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=reward-images

# ===== Initial seed (npm run db:seed) =====
SEED_OWNER_EMAIL=owner@ponyclub.local
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=俱乐部主理人

# ===== SMTP reserved; P3-A uses Resend =====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
