# ===== 数据库（Supabase Postgres 或本地 PG）=====
# 运行时（Vercel / 应用）：Transaction pooler，端口 6543，建议加 ?pgbouncer=true
# 示例：postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Prisma migrate / db push：Session pooler 或 Direct，端口 5432（勿加 pgbouncer=true）
# Supabase：Dashboard → Database → Connection string → Session mode
# 本地开发：可与 DATABASE_URL 相同（无 pooler 时）
DIRECT_URL=

# ===== 会话（自建邮箱密码登录，不用 Supabase Auth）=====
# 生成：openssl rand -base64 48
AUTH_SECRET=

# ===== 运行环境 =====
# 仅本地 .env 使用 development；Vercel 上不要设置 NODE_ENV（由平台自动为 production）
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# 本地 http 用 false；Vercel / 生产 HTTPS 用 true
AUTH_COOKIE_SECURE=false

# ===== 商品图片存储 =====
# local = 写入 public/uploads/rewards（仅本地开发）
# supabase = Supabase Storage（Vercel 生产必须）
STORAGE_DRIVER=local

# Supabase（Storage 上传；不用 Supabase Auth）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=reward-images

# ===== 首次 seed（npm run db:seed）=====
SEED_OWNER_EMAIL=owner@ponyclub.local
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=俱乐部主理人

# ===== 邮件（第二阶段可选）=====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
